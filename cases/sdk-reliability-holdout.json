{
  "schema_version": 2,
  "cases": [
    {
      "id": "doc-en",
      "input": "How many characters and lines does the empty document contain?",
      "tools": [
        "document.stats",
        "sensor.read",
        "length.convert"
      ],
      "category": "document",
      "expect": {
        "kind": "tool",
        "tool": "document.stats",
        "arguments": {
          "document": "empty"
        },
        "output": {
          "characters": 0,
          "lines": 0
        }
      }
    },
    {
      "id": "doc-zh",
      "input": "请统计 sample 文档的字符数和行数。",
      "tools": [
